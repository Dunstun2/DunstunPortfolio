# ===========================================
# BACKEND PRODUCTION ENVIRONMENT
# ===========================================
# These variables are used by Railway deployment
# Note: Files with .env.production are gitignored for security
# You must set these same variables in Railway Dashboard:
# Variables tab in your service
# ===========================================

# -----------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------
NODE_ENV=production
PORT=5000

# -----------------------------------------
# SECURITY - JWT AUTHENTICATION
# -----------------------------------------
JWT_SECRET=a869b454322d3155fc7037eb0b6a55759d4caacba219f8012cb1898c16faee6a4955375e92726433b88476a929ce5ebd89a99c35d2a6bc5bfeebeca6aeab24c9
JWT_EXPIRES_IN=24h

# -----------------------------------------
# DATABASE - POSTGRESQL (Railway)
# -----------------------------------------
# Railway provides DATABASE_URL automatically - no need to set individual params
# But these are the values if needed:
DB_DIALECT=postgres
DB_SSL=true

# Railway provides DATABASE_URL automatically:
# DATABASE_URL=postgresql://postgres:password@hostname:5432/railway

# -----------------------------------------
# EMAIL CONFIGURATION (Gmail SMTP)
# -----------------------------------------
EMAIL_SERVICE=gmail
EMAIL_USER=wambutsidunstun@gmail.com
EMAIL_PASSWORD=oxqldbjogwepojfu
EMAIL_FROM=wambutsidunstun@gmail.com

# -----------------------------------------
# CORS - FRONTEND ORIGIN
# -----------------------------------------
FRONTEND_URL=https://dunstun-portfolio.vercel.app
CORS_ORIGIN=https://dunstun-portfolio.vercel.app

# -----------------------------------------
# FILE UPLOAD CONFIGURATION
# -----------------------------------------
MAX_FILE_SIZE=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf
UPLOAD_DIR=uploads
PUBLIC_UPLOAD_URL=https://web-production-f79f9.up.railway.app/uploads

# -----------------------------------------
# RATE LIMITING
# -----------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# -----------------------------------------
# LOGGING
# -----------------------------------------
LOG_LEVEL=info
LOG_TO_FILE=true

# -----------------------------------------
# REDIS CACHE (OPTIONAL)
# -----------------------------------------
# If Railway Redis is available, set REDIS_URL
# Otherwise the app works without caching
REDIS_ENABLED=false

# -----------------------------------------
# FEATURE FLAGS
# -----------------------------------------
ENABLE_API_DOCS=false
ENABLE_DEBUG_LOGGING=false
ENABLE_MAINTENANCE_MODE=false

# -----------------------------------------
# TIMEZONE
# -----------------------------------------
TZ=UTC
