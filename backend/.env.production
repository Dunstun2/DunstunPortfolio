# ===========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===========================================
# 
# ⚠️  SECURITY WARNING: 
# - NEVER commit this file to version control
# - Use your hosting platform's secret management
# - Generate strong, unique values for all secrets
# 
# Setup Instructions:
# 1. Copy this file's contents to your hosting platform's environment variables
# 2. Replace ALL placeholder values with actual production values
# 3. Keep this file secure and backed up separately
# ===========================================

# -----------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------
NODE_ENV=production
PORT=5000

# -----------------------------------------
# SECURITY - JWT AUTHENTICATION
# -----------------------------------------
# 🔐 CRITICAL: Generate a strong random secret
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# This should be at least 64 characters long
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_64_CHARS_OR_MORE

# JWT token expiration (optional - defaults to 24h)
JWT_EXPIRES_IN=24h

# -----------------------------------------
# DATABASE - POSTGRESQL (PRODUCTION)
# -----------------------------------------
# Option 1: Use individual parameters
DB_DIALECT=postgres
DB_HOST=your-postgres-host.railway.app
DB_PORT=5432
DB_NAME=railway
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_SSL=true

# Option 2: Use DATABASE_URL (some platforms like Railway/Heroku provide this)
# Uncomment if your platform provides DATABASE_URL
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Database connection pool settings (optional - for high traffic)
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# -----------------------------------------
# EMAIL CONFIGURATION (SMTP)
# -----------------------------------------
# Gmail Setup:
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Generate an App Password for "Mail"
# 4. Use that 16-character password below (no spaces)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SENDER_NAME=Your Name
SENDER_EMAIL=your-email@gmail.com

# Contact form recipient (where messages are sent)
CONTACT_EMAIL=your-email@gmail.com

# Alternative SMTP Providers:
# ------------------------------
# SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key
# 
# AWS SES:
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=your_ses_smtp_username
# SMTP_PASS=your_ses_smtp_password
# 
# Mailgun:
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@your-domain.mailgun.org
# SMTP_PASS=your_mailgun_smtp_password

# -----------------------------------------
# REDIS CACHE (OPTIONAL BUT RECOMMENDED)
# -----------------------------------------
# Redis improves performance by caching API responses
# 
# Option 1: Railway/Render Redis Add-on (they provide REDIS_URL)
REDIS_URL=redis://default:password@redis-host:6379

# Option 2: Manual Configuration
# REDIS_HOST=your-redis-host.railway.app
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password
# REDIS_TLS=true

# If Redis is not available, the app will work without caching
# Set to 'false' to disable Redis entirely
REDIS_ENABLED=true

# Cache TTL in seconds (default: 300 = 5 minutes)
CACHE_TTL=300

# -----------------------------------------
# CORS - FRONTEND ORIGIN
# -----------------------------------------
# Set this to your frontend production URL
# Multiple origins: separate with commas
FRONTEND_URL=https://your-domain.com
CORS_ORIGIN=https://your-domain.com,https://www.your-domain.com

# -----------------------------------------
# FILE UPLOAD CONFIGURATION
# -----------------------------------------
# Maximum file size in MB
MAX_FILE_SIZE=10

# Allowed file types (comma-separated)
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Upload directory (relative to backend folder)
UPLOAD_DIR=uploads

# Public URL for uploaded files
# If using CDN (Cloudflare, AWS S3, etc.), put that URL here
PUBLIC_UPLOAD_URL=https://your-domain.com/uploads

# -----------------------------------------
# RATE LIMITING (SECURITY)
# -----------------------------------------
# Prevents abuse and DDoS attacks
# windowMs: time window in milliseconds (15 minutes = 900000)
# max: maximum requests per window per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Stricter limits for authentication endpoints
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# -----------------------------------------
# LOGGING
# -----------------------------------------
# Log level: error, warn, info, http, debug
LOG_LEVEL=info

# Log to file (true/false)
LOG_TO_FILE=true

# -----------------------------------------
# SESSION CONFIGURATION (IF USING SESSIONS)
# -----------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_STRONG_RANDOM_SESSION_SECRET

# -----------------------------------------
# API KEYS (IF USING THIRD-PARTY SERVICES)
# -----------------------------------------
# Example: Analytics, Payment Gateways, etc.
# ANALYTICS_API_KEY=your_analytics_key
# STRIPE_SECRET_KEY=sk_live_xxxxx
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# -----------------------------------------
# FEATURE FLAGS (OPTIONAL)
# -----------------------------------------
# Enable/disable features in production
ENABLE_API_DOCS=false
ENABLE_DEBUG_LOGGING=false
ENABLE_MAINTENANCE_MODE=false

# -----------------------------------------
# MONITORING & ERROR TRACKING (OPTIONAL)
# -----------------------------------------
# Sentry for error tracking
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# New Relic for performance monitoring
# NEW_RELIC_LICENSE_KEY=your_license_key
# NEW_RELIC_APP_NAME=Portfolio Backend

# -----------------------------------------
# BACKUP CONFIGURATION (OPTIONAL)
# -----------------------------------------
# AWS S3 for backups
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# AWS_BACKUP_BUCKET=portfolio-backups

# -----------------------------------------
# TIMEZONE
# -----------------------------------------
TZ=UTC

# -----------------------------------------
# PLATFORM-SPECIFIC VARIABLES
# -----------------------------------------
# Railway automatically provides these:
# - RAILWAY_ENVIRONMENT
# - RAILWAY_PROJECT_ID
# - RAILWAY_SERVICE_ID
# 
# Render automatically provides these:
# - RENDER_SERVICE_ID
# - RENDER_EXTERNAL_URL
# 
# Vercel automatically provides these:
# - VERCEL_ENV
# - VERCEL_URL

# ===========================================
# END OF CONFIGURATION
# ===========================================
