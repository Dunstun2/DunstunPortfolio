# Server Configuration
PORT=5000

# JWT Secret - Generate a strong random secret for production
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production

# Email Configuration
# Option 1: Gmail (recommended for simplicity)
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-gmail-app-password

# Option 2: Generic SMTP (Gmail or other providers)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# Sender details (displayed in emails)
SENDER_NAME=Your Name
SENDER_EMAIL=your-email@gmail.com

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# Database (optional - defaults to SQLite)
# DATABASE_URL=sqlite:./database.sqlite

# Redis (optional - for caching)
# If not configured, caching will be disabled but app will work normally
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Or use a Redis URL (alternative to HOST/PORT/PASSWORD)
# REDIS_URL=redis://username:password@hostname:port

# Node Environment
NODE_ENV=development
